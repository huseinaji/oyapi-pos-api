{
  "name": "oyapi-pos-api",
  "version": "0.0.1",
  "description": "POS app untuk retail umkm",
  "author": "huseinaji",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "bun run nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun run nest start",
    "start:dev": "bun --env-file=.env --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun --env-file=.env dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:debug": "bun --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "bun ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "migrate": "bun ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "migrate:undo": "bun ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.3",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^12.1.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/sequelize": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@types/sequelize": "^6.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "fastify-session-redis-store": "^7.1.2",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.3",
    "nest-winston": "^2.0.0",
    "pg": "^8.23.0",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "ulid": "^3.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
